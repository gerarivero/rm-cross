# Datos del proyecto Supabase (Settings > API en el dashboard de Supabase).
# Copiar este archivo a .env.local y completar con los valores reales.
# SUPABASE_SERVICE_ROLE_KEY es secreta: nunca exponerla al cliente ni commitearla.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Usadas por el cliente de browser y el middleware (createServerClient con la
# anon key). Se inlinean en el build, por eso van con prefijo NEXT_PUBLIC_.
# La anon key es pública por diseño (protegida por Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
